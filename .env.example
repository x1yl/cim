# Server
PORT=3001
HOST=0.0.0.0

# Mistral moderation (server-side only)
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODERATION_MODEL=mistral-moderation-2603
# Set to false to disable moderation entirely
MODERATION_ENABLED=true
# Set to true to reject messages if the moderation API is unreachable
MODERATION_FAIL_CLOSED=false
MODERATION_TIMEOUT_MS=8000
